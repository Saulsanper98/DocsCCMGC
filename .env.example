# Supabase
VITE_SUPABASE_URL=https://[project].supabase.co
VITE_SUPABASE_ANON_KEY=[anon_key]
SUPABASE_SERVICE_ROLE_KEY=[service_role_key]

# Asistente IA (elegir UNA vía)
# Gratis, local: instalar Ollama (https://ollama.com), `ollama pull llama3.2`, y:
VITE_AI_PROVIDER=ollama
# VITE_OLLAMA_URL=http://127.0.0.1:11434
# VITE_OLLAMA_MODEL=llama3.2
# Velocidad (por defecto la app ya usa ctx 2048, salida 768, temp 0.55; ajusta si hace falta)
# VITE_OLLAMA_NUM_CTX=1536
# VITE_OLLAMA_MAX_TOKENS=512
# VITE_OLLAMA_TEMPERATURE=0.45
# VITE_OLLAMA_TOP_P=0.9
# VITE_OLLAMA_MAX_CONTEXT_CHARS=10000
# VITE_OLLAMA_MAX_INPUT_CHARS=16000
# VITE_OLLAMA_MAX_INPUT_HEAVY_ACTION_CHARS=12000
# VITE_OLLAMA_MAX_TOKENS_KEYPOINTS=448
# VITE_OLLAMA_MAX_TOKENS_SUMMARY=512
# Siguientes mensajes más rápidos (más RAM): VITE_OLLAMA_KEEP_ALIVE=10m
# Menos documentos por petición: VITE_COPILOT_CONTEXT_MAX_DOCS=14
# VITE_COPILOT_CONTEXT_SNIPPET_CHARS=220
# Límites CPU (opcional)
# VITE_OLLAMA_NUM_THREAD=6
# VITE_OLLAMA_KEEP_ALIVE=45s
# En el navegador, si falla CORS: variable de usuario/sistema OLLAMA_ORIGINS con el origen de la app.

# Ollama (servidor): variables de sistema o de usuario en Windows, luego reiniciar Ollama desde la bandeja.
# Evitan colas agresivas y liberan memoria antes (ajustar a tu RAM/VRAM):
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_KEEP_ALIVE=30s
# OLLAMA_MAX_QUEUE=8
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_FLASH_ATTENTION=1

# Microsoft / Azure OpenAI — solo con contrato/licencia (no usar si queréis solo Ollama)
VITE_ENABLE_COPILOT=false
VITE_AZURE_CLIENT_ID=[azure_app_client_id]
VITE_AZURE_TENANT_ID=[azure_tenant_id]
VITE_AZURE_OPENAI_ENDPOINT=https://[resource].openai.azure.com/
VITE_AZURE_OPENAI_KEY=[api_key]
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# App
VITE_APP_NAME=DocBrain CCMGC
VITE_APP_URL=https://docbrain.ccmgc.es

# Usuarios de prueba (opcional; si no, usa defaults del script)
TEST_ADMIN_EMAIL=admin.test@ccmgc.es
TEST_ADMIN_PASSWORD=Admin12345!
TEST_EDITOR_EMAIL=editor.test@ccmgc.es
TEST_EDITOR_PASSWORD=Editor12345!
TEST_VIEWER_EMAIL=viewer.test@ccmgc.es
TEST_VIEWER_PASSWORD=Viewer12345!
TEST_OPERATOR_EMAIL=operator.test@ccmgc.es
TEST_OPERATOR_PASSWORD=Operator12345!
